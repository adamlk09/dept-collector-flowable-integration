<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.deptcollector</groupId>
  <artifactId>dept-collector-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Dept Collector Backend</name>

  <properties>
    <java.version>21</java.version>
    <spring-boot.version>3.5.12</spring-boot.version>
    <flowable.version>7.2.0</flowable.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <modules>
    <module>shared-kernel</module>
    <module>api-gateway</module>
    <module>services/tenant-service</module>
    <module>services/billing-service</module>
    <module>services/tenant-config-service</module>
    <module>services/feature-flag-service</module>
    <module>services/customer-service</module>
    <module>services/debt-service</module>
    <module>services/contract-service</module>
    <module>services/cheque-service</module>
    <module>services/guarantee-service</module>
    <module>services/organization-service</module>
    <module>services/case-service</module>
    <module>services/segmentation-service</module>
    <module>services/assignment-service</module>
    <module>services/workflow-service</module>
    <module>services/notification-service</module>
    <module>services/payment-service</module>
    <module>services/legal-service</module>
    <module>services/agency-service</module>
    <module>services/document-service</module>
    <module>services/kpi-service</module>
    <module>services/scoring-service</module>
    <module>services/audit-service</module>
    <module>services/configuration-service</module>
    <module>services/reference-data-service</module>
    <module>services/data-contract-service</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.1</version>
          <configuration>
            <release>${java.version}</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
